{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTourVaultBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tourvault-assets-652284807651"
    },
    {
      "Sid": "ReadWriteTourVaultObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::tourvault-assets-652284807651/*"
    }
  ]
}
